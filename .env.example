# Session signing secret: generate with `openssl rand -base64 48`.
GARDEN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Required in production; leave empty for localhost.
GARDEN_SITE_URL=

# GitHub OAuth App used only to verify the studio owner.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Both values must match the account allowed into /admin.
GARDEN_ADMIN_GITHUB_USER=shayantimes
GARDEN_ADMIN_GITHUB_ID=140486239

# Fine-grained PAT, scoped only to this repo, with Contents: Read and write.
GARDEN_GITHUB_TOKEN=
GARDEN_GITHUB_REPO=shayantimes/Digital_Garden
GARDEN_GITHUB_BRANCH=main

# Local development only. This is forcibly ignored in production.
GARDEN_DEV_BYPASS_AUTH=false
