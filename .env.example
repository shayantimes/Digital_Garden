# Canonical site origin. Use http://localhost:3000 locally and HTTPS in production.
GARDEN_SITE_URL=http://localhost:3000

# The only identity allowed into /admin.
GARDEN_ADMIN_USERNAME=choose-your-private-username
GARDEN_ADMIN_EMAIL=you@example.com
# Optional defense-in-depth after account creation: copy its immutable UUID.
GARDEN_ADMIN_USER_ID=
# One-time switch. Set true only while creating the first owner, then remove it.
GARDEN_OWNER_SETUP_ENABLED=false

# Supabase Project Settings > API. The publishable key is used only server-side here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# CMS publishing backend. This is not used for authentication.
GARDEN_GITHUB_TOKEN=
GARDEN_GITHUB_REPO=shayantimes/Digital_Garden
GARDEN_GITHUB_BRANCH=main
